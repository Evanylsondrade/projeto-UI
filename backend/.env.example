# Copie para backend/.env se precisar alterar os valores padrão.
HOST=127.0.0.1
PORT=3001
# Caminho relativo à pasta backend; nunca coloque este arquivo na pasta pública.
DATABASE_PATH=./data/smartpet.sqlite

# Em produção: NODE_ENV=production, APP_ORIGINS=https://seu-dominio e proxy HTTPS.
# APP_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
COOKIE_SECURE=false

# Preencha somente para executar npm run auth:bootstrap pela primeira vez.
# Nenhuma senha padrão é fornecida. Use 15 a 128 caracteres e remova após criar.
BOOTSTRAP_NAME=
BOOTSTRAP_EMAIL=
BOOTSTRAP_PASSWORD=
